# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag
POSTGRES_PORT=5433
# NOTE: host port is 5433, not 5432 - a native PostgreSQL install already
# owns 5432 on this machine. Docker Compose still maps it to 5432 internally.
# Admin/owner role - migrations only. Never used by the running API.
DATABASE_URL=postgresql://rag:rag_dev_password@localhost:5433/rag
# Runtime role (rag_app) - created by db:migrate's bootstrap step. RLS applies
# to every query made through this connection.
DATABASE_URL_APP=postgresql://rag_app:rag_app_dev_password@localhost:5433/rag

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=rag_minio_admin
MINIO_ROOT_PASSWORD=rag_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# --- Auth (local JWT stub for now, Clerk later) ---
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d

# --- Ollama (local LLM, no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=all-minilm

# --- API ---
API_PORT=3001
